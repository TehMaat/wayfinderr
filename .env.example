# Docker Compose settings: copy to .env and edit.
# (For a local run without Docker use backend/.env.example instead.)

# Folder on this machine where MakeMKV saves the .mkv files (e.g. D:/MakeMKV)
MAKEMKV_OUTPUT_DIR=./makemkv-output

# Delete the local .mkv once it is on the server
DELETE_AFTER_UPLOAD=false

# Automatic ripping: film discs (ISO, BDMV, VIDEO_TS) that finish downloading in
# DOWNLOADS_DIR are ripped by the makemkv service (docker compose --profile makemkv).
# RAR archives there are unpacked first (on the disk with more free space: the
# downloads one or the watch folder one): a disc inside is ripped, an .mkv uploaded
RIP_ENABLED=false
DOWNLOADS_DIR=./downloads
# Also rip the downloads already there the first time (otherwise only new ones)
RIP_EXISTING=false
# themoviedb.org API key (v3) or read access token: names the files, picks the languages,
# and matches uploaded films to their torrent in any language (Clients page)
TMDB_API_KEY=
# MakeMKV registration key, or BETA for the free beta key
MAKEMKV_KEY=BETA

# Set to true when the folder is on Windows/macOS or on a network share:
# Docker Desktop does not forward file events from those folders
WATCH_USE_POLLING=false

MAX_CONCURRENT_UPLOADS=2

LOG_LEVEL=info

# Image version: latest (last commit on main), a release like 1.0.0, or sha-<commit>
WAYFINDERR_TAG=latest

# Optional: fixed setup code for creating the login account (otherwise printed in the backend log)
# WAYFINDERR_SETUP_CODE=
