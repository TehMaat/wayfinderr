# Backend Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# Database
DATABASE_URL=file:./data/wayfinderr.db

# File Watching
WATCH_DIR=/makemkv-output

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: Server Configuration (can also be set via UI)
# SERVER_1_NAME=Server 1
# SERVER_1_API_ENDPOINT=https://username.hostname.usbx.me/ultra-api/get_diskquota
# SERVER_1_API_TOKEN=your_token_here
# SERVER_1_SSH_HOST=hostname.usbx.me
# SERVER_1_SSH_PORT=22
# SERVER_1_SSH_USERNAME=your_username

# Upload Settings
MAX_CONCURRENT_UPLOADS=2
MAX_RETRIES=3
RETRY_BACKOFF_STRATEGY=exponential

# Media Settings
REQUIRE_ITALIAN_MEDIA=true
SKIP_NO_ITALIAN_POLICY=true
