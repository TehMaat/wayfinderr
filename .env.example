# Docker Compose settings: copy to .env and edit.
# (For a local run without Docker use backend/.env.example instead.)

# Folder on this machine where MakeMKV saves the .mkv files (e.g. D:/MakeMKV)
MAKEMKV_OUTPUT_DIR=./makemkv-output

# Set to true when the folder is on Windows/macOS or on a network share:
# Docker Desktop does not forward file events from those folders
WATCH_USE_POLLING=false

MAX_CONCURRENT_UPLOADS=2
LOG_LEVEL=info

# Image version: latest (last commit on main), a release like 1.0.0, or sha-<commit>
WAYFINDERR_TAG=latest

# Optional: fixed setup code for creating the login account (otherwise printed in the backend log)
# WAYFINDERR_SETUP_CODE=
