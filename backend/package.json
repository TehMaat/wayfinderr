{
  "name": "wayfinderr-backend",
  "version": "1.0.0",
  "description": "Wayfinderr - Automatic MKV file uploader with smart server selection",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "reset-auth": "node dist/cli.js reset-auth"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "axios": "^1.6.2",
    "chokidar": "^3.5.3",
    "express": "^4.18.2",
    "p-queue": "^6.6.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prisma": "^5.7.0",
    "ssh2": "^1.14.0",
    "ws": "^8.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ssh2": "^1.11.15",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
