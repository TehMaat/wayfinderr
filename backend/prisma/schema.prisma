// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Server {
  id                   String   @id @default(cuid())
  name                 String
  apiEndpoint          String
  apiToken             String
  sshHost              String
  sshPort              Int      @default(22)
  sshUsername          String
  sshPassword          String?  // Optional: if empty, SSH_PRIVATE_KEY_PATH is used
  sshPath              String   @default("/uploads")

  // Configuration
  maxRetries           Int      @default(3)
  backoffStrategy      String   @default("exponential") // "exponential" | "linear"
  mediaCheckPolicy     String   @default("SKIP_NO_ITA")  // "SKIP_NO_ITA" | "ALWAYS_UPLOAD"

  // Release on the server (see services/release): the uploaded file is renamed into
  // releaseDir/<name>/<name>.mkv, then trackerCommand (e.g. Unit3Dup) uploads it to the tracker
  releaseDir           String   @default("downloads/qbittorrent") // relative to the SSH home, or absolute
  releaseTag           String?  // "-TAG" at the end of the name (blank = none)
  trackerCommand       String?  // {path} {folder} {name} are replaced; blank = rename only
  releaseAuto          Boolean  @default(false) // after each upload, ask for the name right away

  // Caching
  lastSpaceCheckAt     DateTime?
  cachedFreeSpaceBytes BigInt?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  uploads              Upload[]

  @@index([name])
}

model Upload {
  id                   String   @id @default(cuid())
  filename             String
  filepath             String
  size                 BigInt   // File size in bytes

  // Media information
  mediaInfo            String?  // JSON: {audioTracks: [{lang, codec}], subtitles: [{lang, codec}]}
  hasItalianAudio      Boolean  @default(false)
  hasItalianSubtitles  Boolean  @default(false)

  // Upload details
  serverId             String?
  server               Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)

  status               String   @default("PENDING")  // PENDING | QUEUED | UPLOADING | COMPLETED | FAILED | SKIPPED | CANCELLED
  progress             Int      @default(0)          // 0-100
  progressBytes        BigInt   @default(0)          // Bytes uploaded

  // Retry tracking
  currentRetryCount    Int      @default(0)
  retryStrategy        String?  // "exponential" | "linear" from server config

  // Timestamps
  startedAt            DateTime?
  completedAt          DateTime?
  error                String?  // Error message if failed

  // Torrent cleanup: the qBittorrent torrent the MKV was ripped from
  // torrentStatus: null (not checked) | NO_MATCH | REVIEW | WAITING | REMOVED | ERROR
  torrentStatus        String?
  torrentClientId      String?
  torrentHash          String?
  torrentName          String?
  torrentScore         Int?     // 0-100 name match score
  torrentMessage       String?  // Why it was (not) removed
  torrentTracker       String?  // the torrent's tracker host (no passkey), kept once it is removed

  // Where the file is on the server (set once uploaded; changes when renamed)
  remotePath           String?
  remoteFound          Boolean? // null: not looked for; false: not found on the server (see release link)

  // Release (see services/release): renamed on the server, then uploaded to the tracker
  // releaseStatus: null | CONFIRM (name to confirm) | RENAMED | QUEUED | RUNNING | NEEDS_INPUT
  //                | DONE | SKIPPED | UNKNOWN | FAILED | CANCELLED
  releaseStatus        String?
  releaseName          String?  // the file name on the server after the rename
  releasePrompt        String?  // JSON {kind, text}: the question the tracker command waits on
  releaseLog           String?  // the command's output (cleaned, last part only)
  releaseOffset        Int      @default(0) // bytes of the remote output log already read
  releaseMessage       String?  // outcome, or why it failed
  releaseStartedAt     DateTime?
  releaseCompletedAt   DateTime?

  // The .torrent the tracker gave back (from the Unit3Dup archive on the server, see release/index.ts)
  releaseTracker       String?  // the archive's folder: the tracker's name (e.g. ITT)
  releaseTorrentName   String?  // file name of the .torrent
  releaseTorrentPath   String?  // where it is on the server
  releaseTorrentHash   String?  // v1 info hash
  releaseTorrentData   Bytes?   // the file itself (left out of the list and the details)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([serverId])
  @@index([torrentStatus])
  @@index([releaseStatus])
}

// Download client the source torrents come from (qBittorrent WebUI API)
model TorrentClient {
  id                   String   @id @default(cuid())
  name                 String
  url                  String   // e.g. http://localhost:8080
  username             String?  // Blank: no login (WebUI auth bypass for this host)
  password             String?
  apiKey               String?  // qBittorrent 5.2+: used instead of username/password
  category             String?  // Only look at torrents in this category (blank = all)

  enabled              Boolean  @default(true)
  autoRemove           Boolean  @default(true)  // false: only suggest, remove from the UI
  deleteFiles          Boolean  @default(false) // Also delete the downloaded data (ISO/BDMV)

  // Low disk space on this machine: every torrent is paused below this many GB free (null = off)
  minFreeGB            Float?
  spacePausedAt        DateTime? // Set while its torrents are paused for low space
  spaceMessage         String?   // Last pause/resume, or why it failed

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Key/value app settings: the login account and the session signing secret
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A film disc (ISO, BDMV or VIDEO_TS folder) found in the downloads folder,
// ripped to MKV by the MakeMKV container (see services/ripper), or a RAR
// archive holding a disc or an .mkv, unpacked first
model Rip {
  id               String    @id @default(cuid())
  sourcePath       String    @unique // relative to RIP_SOURCE_DIR (an archive: its first volume)
  sourceType       String    // ISO | BDMV | DVD | RAR
  downloadName     String    // top-level entry of the downloads folder

  status           String    @default("WAITING") // WAITING | QUEUED | UNPACKING | SCANNING | RIPPING | JOINING | DONE | NEEDS_ATTENTION | FAILED | SKIPPED
  reason           String?   // why it needs attention, failed or was skipped
  hidden           Boolean   @default(false) // a skipped rip removed from the list: kept so the downloads scan doesn't list it again

  // RAR archive (see ripper/archive.ts): the film inside, and where it is unpacked
  contentType      String?   // ISO | BDMV | DVD | MKV
  contentPath      String?   // the .iso/.mkv file or the disc folder, inside the archive ("." = its root)
  unpackBytes      BigInt?   // size of every file in the archive
  unpackedTo       String?   // downloads | watch: the disk it is (being) unpacked on; null when not unpacked

  // What rips the disc: makemkv (the MakeMKV container), or remux (mkvmerge or ffmpeg in the
  // backend, chosen in the UI when MakeMKV fails: see ripper/remux.ts)
  engine           String    @default("makemkv")

  // Disc scan (makemkvcon info, or the remux scan): JSON array of the titles, see ripper/makemkv.ts
  discName         String?
  titles           String?
  titleIndex       Int?      // title to rip (chosen automatically or by the user)

  // Discs of one film joined by hand (see ripper/join.ts): each one is ripped, then mkvmerge
  // appends them in order into one file
  joinId           String?   // the id of the join's first part (its own id on the first part)
  joinPart         Int?      // 1, 2...: the order of the parts

  // TMDB match
  tmdbId           Int?
  title            String?   // in TMDB_LANGUAGE (used for the file name)
  originalTitle    String?
  originalLanguage String?   // ISO 639-1, from TMDB
  year             Int?

  jobId            String?   // current runner job
  progress         Int       @default(0) // 0-100
  outputFile       String?   // final .mkv path, in the watch folder (or where an archive was unpacked in the downloads)

  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([joinId])
}
