# Local run (npm run dev / npm start): copy to backend/.env and edit.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# SQLite file, path relative to backend/prisma/
DATABASE_URL=file:../data/wayfinderr.db

# Folder where MakeMKV saves the .mkv files (e.g. D:/MakeMKV on Windows)
WATCH_DIR=./makemkv-output
WATCH_USE_POLLING=false

MAX_CONCURRENT_UPLOADS=2

# Automatic ripping (see the README): RAR archives in the downloads are unpacked
# with unrar, which must be installed (Windows: C:/Program Files/WinRAR/UnRAR.exe)
# UNRAR_PATH=unrar
# "Rip without MakeMKV", when MakeMKV fails: mkvmerge (MKVToolNix) for Blu-ray,
# 7-Zip for ISO images, ffmpeg 7+ with DVD support for DVDs (on the PATH, or set here)
# MKVMERGE_PATH=mkvmerge
# SEVENZIP_PATH=7zz
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Optional: SSH private key used for servers saved without a password
# SSH_PRIVATE_KEY_PATH=C:/Users/you/.ssh/id_ed25519

# Optional: themoviedb.org key, also used to match uploaded films to their
# qBittorrent torrent in any language (Clients page)
# TMDB_API_KEY=
